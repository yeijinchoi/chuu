  { "id": "stage_cloak", "name": "바랜 금빛 무대 망토", "shift": "dawn", "category": "apparel", "kind": "망토", "color": "beige", "price": 6800000, "description": "안감이 수십 개의 하얀 가면으로 덮여 있다. 전부 이쪽을 본다. 두르면 보이지 않는 객석이 박수를 친다." },
  { "id": "shadow_scarf", "name": "남의 그림자 스카프", "shift": "dawn", "category": "apparel", "kind": "스카프", "color": "black", "price": 2200000, "description": "두르면 그림자가 원래 주인의 모양이 된다. 그 그림자는 벽에서 나오려고 손을 뻗는다." },
  { "id": "breathing_pearl", "name": "숨 쉬는 진주", "shift": "dawn", "category": "jewelry", "kind": "목걸이", "color": "white", "price": 8800000, "description": "진주가 아니라 젖은 눈알이다. 양옆의 아가미로 숨을 쉰다. 가끔 숨을 참고 이쪽을 본다." },
  { "id": "drowned_choker", "name": "익사하지 않는 초커", "shift": "dawn", "category": "jewelry", "kind": "초커", "color": "black", "price": 6600000, "description": "따개비가 빽빽하게 붙어 있고 그 사이로 작은 촉수가 꿈틀거린다. 착용자는 물속에서 말할 수 있다. 무엇과 말하게 될지는 모른다." },
  { "id": "backward_watch", "name": "거꾸로 가는 회중시계", "shift": "dawn", "category": "jewelry", "kind": "회중시계", "color": "white", "price": 5500000, "description": "숫자 대신 사람 이가 박혀 있고, 바늘은 뼈만 남은 손가락이다. 거꾸로 간다. 어제를 조금 늘려 줄 뿐이다." },
